# Google Gemini API key used by the server-side wall segmentation endpoint
# (/api/segment). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the Gemini model used for wall detection.
# Defaults to gemini-3.6-flash when unset.
GEMINI_MODEL=gemini-3.6-flash

# Optional: override the image-editing model used for wall segmentation
# (the primary method). Defaults to gemini-3.1-flash-image when unset.
GEMINI_EDIT_MODEL=gemini-3.1-flash-image

# Segmentation method: "auto" (edit-first, polygon fallback) | "edit" | "polygon".
# Defaults to "auto".
GEMINI_SEGMENT_MODE=auto
